# Godot 4 のエディタキャッシュとインポート済みアセット
.godot/

# ローカルパスや署名情報を含みうるため除外
export_presets.cfg

# Orca のワークツリーと配信ワークフローの作業記録。ローカル環境固有。
.orca/

.DS_Store

# キャラクターモデルの実体はローカル専用の入力。リポジトリとリリースには含めない。
# 取り込み手順と公開時の方針は docs/model-import.md を参照。
assets/models/*
!assets/models/.gitkeep

# モデル作成・変換時に別の場所へ置いたファイルも誤って公開しない。
# 公開可能なアセットを将来追加する場合は、個別のライセンス表示と明示的な
# allowlist を先に用意する。
*.vrm
*.pmx
*.pmd
*.fbx
*.blend
*.glb
*.gltf

# ローカルの認証情報・署名情報
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
